# Firebase Firestore Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Cloudinary Storage Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=himasefess_preset

# Telegram Bot Notification Configuration
# Token didapat dari @BotFather di Telegram
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Chat ID grup pengurus (biasanya bernilai negatif, contoh: -1001234567890)
VITE_TELEGRAM_CHAT_ID=your_telegram_group_chat_id

# Optional: Backend API / Proxy jika tidak memanggil Telegram Bot API secara langsung
VITE_BACKEND_API_URL=https://your-backend-api.com

# Google YouTube Data API v3 Configuration
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
